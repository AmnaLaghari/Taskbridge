# Copy to .env. docker compose works without it; local tooling (pytest, mypy) needs it.

DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_DEBUG=true
DATABASE_URL=postgres://taskbridge:taskbridge@localhost:5432/taskbridge
REDIS_URL=redis://localhost:6379/0

# GitHub: fine-grained PAT with Issues read/write on the sync target repo
GITHUB_TOKEN=
GITHUB_REPO=owner/taskbridge-sandbox

# Todoist: app console at https://developer.todoist.com/appconsole.html
TODOIST_API_TOKEN=
TODOIST_PROJECT_ID=
TODOIST_CLIENT_ID=
TODOIST_CLIENT_SECRET=
